import numpy as np
import random

Q = np.zeros((4, 2))

for episode in range(1000):
    state = 0

    while state != 3:
        if random.random() < 0.1:
            action = random.randint(0, 1)
        else:
            action = np.argmax(Q[state])

        next_state = state + 1 if action == 1 else max(0, state - 1)

        reward = 10 if next_state == 3 else -1

        Q[state, action] += 0.1 * (
            reward + 0.9 * max(Q[next_state]) - Q[state, action]
        )

        state = next_state

print("Q Table:")
print(Q)

print("Optimal Policy:")
for state in range(3):
    print(state, "->", np.argmax(Q[state]))
