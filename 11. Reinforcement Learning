
import numpy as np
import random

Q = np.zeros((16, 4))

alpha = 0.1
gamma = 0.9
epsilon = 0.1

def move(state, action):
    row, col = divmod(state, 4)

    if action == 0:
        row = max(0, row - 1)
    elif action == 1:
        row = min(3, row + 1)
    elif action == 2:
        col = max(0, col - 1)
    else:
        col = min(3, col + 1)

    return row * 4 + col

for episode in range(5000):
    state = 0

    while state != 15:
        if random.random() < epsilon:
            action = random.randint(0, 3)
        else:
            action = np.argmax(Q[state])

        next_state = move(state, action)
        reward = 10 if next_state == 15 else -1

        Q[state, action] += alpha * (
            reward + gamma * np.max(Q[next_state]) - Q[state, action]
        )

        state = next_state

state = 0
steps = 0

while state != 15 and steps < 30:
    action = np.argmax(Q[state])
    state = move(state, action)
    steps += 1

print("Steps to reach goal:", steps)
print("Learned Q-Table:")
print(Q)
