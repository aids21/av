import numpy as np
import random

Q = np.zeros((4, 2))

alpha = 0.1
gamma = 0.9
epsilon = 0.1

for episode in range(1000):
    state = 0
    steps = 0

    while state != 3 and steps < 20:

        if random.random() < epsilon:
            action = random.randint(0, 1)
        else:
            action = np.argmax(Q[state])

        next_state = state + 1 if action == 1 else max(0, state - 1)

        reward = 10 if next_state == 3 else -1

        if next_state == 3:
            target = reward
        else:
            target = reward + gamma * max(Q[next_state])

        Q[state, action] += alpha * (target - Q[state, action])

        state = next_state
        steps += 1

print("Q Table:")
print(Q)

print("Optimal Policy:")
for state in range(3):
    action = np.argmax(Q[state])
    print("State", state, "Action", "Right" if action == 1 else "Left")
